{
  "permissions": {
    "deny": [
      "Read(//**/*runbook_filled.md)",
      "Read(**/*runbook_filled.md)",
      "Read(//**/*_private_*/**)",
      "Read(**/*_private_*/**)",
      "Edit(//**/*_private_*/**)",
      "Edit(**/*_private_*/**)",
      "Write(//**/*_private_*/**)",
      "Write(**/*_private_*/**)",
      "Grep(//**/*_private_*/**)",
      "Grep(**/*_private_*/**)",
      "Glob(//**/*_private_*/**)",
      "Glob(**/*_private_*/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-private.sh\"",
            "timeout": 10,
            "statusMessage": "Checking private-data guard"
          }
        ]
      }
    ]
  }
}
