{
  "permissions": {
    "deny": [
      "Read(//**/*runbook_filled.md)",
      "Read(**/*runbook_filled.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-private.sh\"",
            "timeout": 10,
            "statusMessage": "Checking private-data guard"
          }
        ]
      }
    ]
  }
}
